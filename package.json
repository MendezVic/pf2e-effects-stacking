{
  "name": "pf2e-effects-stacking",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Foundry VTT PF2e module that stacks same-type effects from different sources.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "deploy": "node scripts/deploy.ts"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "foundry-pf2e": "github:7H3LaughingMan/foundry-pf2e#78aa843c39a59e06ede407a45ed1fd627169b5a3",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
